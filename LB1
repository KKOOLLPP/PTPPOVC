#include <iostream>
#include <stdio.h>
#include <string.h>

int main() {

    char buffer[255];
    int wct = 0;
    bool inw = false;

    /**
     * @param fopen открытие файла
     * @param fop указатель на файл
     * @param perror вывод сообщения об ошибке
     * @return 0 успешное завершение, 1 ошибка
     */
    FILE* fop = fopen("test.txt", "r");
    if (fop == NULL) {
        perror("Error opening file");
        return 1;
    }
    /**
     * @param fgets считывание строки из файла
     * @param buffer буфер для хранения считанной строки
     * @param sizeof(buffer) размер буфера
     * @param fop указатель на файл
     * @param puts вывод строки на экран
     * @return NULL - конец файла, иначе указатель на считанную строку
     */
    while (fgets(buffer, sizeof(buffer), fop)) {
        /**
         * @param buffer буфер для хранения считанной строки
         * @param inw флаг, указывающий, находимся ли мы внутри слова
         * @param wct счетчик слов
         * @param i индекс текущего символа в буфере
         */
        for (int i = 0; buffer[i] != '\0'; i++) {
            if (buffer[i] == ' ' || buffer[i] == '\t' || buffer[i] == '\n') {
                if (inw) {
                    wct++;
                    inw = false;
                }
            } 
            else {
                inw = true;
            }
        }
    }
    fclose(fop);

    printf("Word count: %d\n", wct);

    return 0;
}
