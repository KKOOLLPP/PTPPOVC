bool cyr(const string& s, size_t i, string& out, int& len) {
    if (i + 1 >= s.size()) return 0;
    unsigned char b1 = (unsigned char)s[i];
    unsigned char b2 = (unsigned char)s[i + 1];

    if (b1 == 0xD0 && b2 >= 0x90 && b2 <= 0x9F) {
        b2 += 0x20;
    }
    else if (b1 == 0xD0 && b2 >= 0xA0 && b2 <= 0xAF) {
        b1 = 0xD1; b2 -= 0x20;
    }
    else if (b1 == 0xD0 && b2 >= 0xB0 && b2 <= 0xBF) {
    }
    else if (b1 == 0xD1 && b2 >= 0x80 && b2 <= 0x8F) {
    }
    else {
        return 0;
    }

    out += (char)b1;
    out += (char)b2;
    len = 2;
    return 1;
}

vector<string> splitWords(const string& s) {
    vector<string> res;
    string cur;

    for (size_t i = 0; i < s.size(); ) {
        int len = 0;
        if (cyr(s, i, cur, len)) { i += len; continue; }

        unsigned char c = (unsigned char)s[i];
        if (isalnum(c)) cur += (char)tolower(c);
        else if (!cur.empty()) { res.push_back(cur); cur.clear(); }
        ++i;
    }
    if (!cur.empty()) res.push_back(cur);
    return res;
}

void WordPositions() {
    FILE* fop = fopen("test.txt", "r");
    if (!fop) { perror("Error opening file"); return; }

    string content;
    char buf[1024];
    size_t n;
    while ((n = fread(buf, 1, sizeof(buf), fop)) > 0) content.append(buf, n);
    fclose(fop);

    vector<string> order;
    map<string, vector<int>> positions;

    int pos = 0;
    for (const string& w : splitWords(content)) {
        if (positions.find(w) == positions.end()) order.push_back(w);
        positions[w].push_back(pos++);
    }

    for (const string& w : order) {
        cout << w << " - ";
        const vector<int>& p = positions[w];
        for (size_t k = 0; k < p.size(); ++k) {
            cout << p[k];
            if (k + 1 < p.size()) cout << ", ";
        }
        cout << "\n";
    }
}

